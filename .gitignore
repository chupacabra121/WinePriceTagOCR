# Secrets
.env

# Photo library (bulk input) — samples under data/samples/ are tracked
data/photos/*
!data/photos/.gitkeep

# Shoot folders kept alongside the repo. ~2 GB of HEIC that git would store
# forever, one full copy per re-shoot.
Mystery shopping/
mystery shopping/

# Outputs and caches
out/*
!out/.gitkeep
.cache/
*.xlsx
!data/samples/**/*.xlsx

# Local store config (may contain real addresses)
config/stores.yaml

# Compiled on first use; architecture-specific
tools/visionocr

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db
